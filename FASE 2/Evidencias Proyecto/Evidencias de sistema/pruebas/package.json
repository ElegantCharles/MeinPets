{
  "name": "meinpets-pruebas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:unitarias": "vitest run --project unitarias",
    "test:integracion": "vitest run --project sistema tests/integracion",
    "test:seguridad": "vitest run --project sistema tests/seguridad",
    "test:rendimiento": "vitest run --project sistema tests/rendimiento",
    "test:informe": "vitest run --reporter=verbose --reporter=junit --outputFile.junit=resultados/junit.xml"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "dotenv": "^18.0.10",
    "pg": "^8.23.1",
    "vitest": "^3.2.7"
  }
}
