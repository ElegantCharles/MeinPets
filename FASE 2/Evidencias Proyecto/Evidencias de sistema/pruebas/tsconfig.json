{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@api/*": ["../aplicacion/api/src/*"],
      "@movil/*": ["../aplicacion/movil/src/*"],
      "react-native": ["./stubs/react-native.ts"]
    }
  },
  "include": ["src", "setup", "stubs", "tests", "vitest.config.ts", "../aplicacion/api/src/types/express.d.ts"]
}
